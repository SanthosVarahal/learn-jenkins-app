pipeline {
    agent any

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_ECS_CLUSTER = 'nginx-service'
        AWS_ECS_SERVICE = 'nginx-web-server-service-g5iwu4ov'
        AWS_ECS_TASK_DEFINITION = 'nginx-web-server'
    }
    
    stages {
        stage('Build') {
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                sh '''
                    ls -la
                    node --version
                    npm --version
                    npm ci 
                    npm run build
                    ls -la
                '''
            }
        }
        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build -t jenkinsapp .
                '''
            }
        }
    }
}